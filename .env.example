# Copia estas variables en Vercel → Project → Settings → Environment Variables.
# NUNCA subas un .env con valores reales al repo.

# --- Protección opcional del dashboard (recomendado) ---
# Si la defines, las funciones /api piden esta clave; el dashboard la solicita una vez.
DASHBOARD_KEY=
ALLOWED_ORIGIN=

# --- Meta Ads ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v26.0
META_PURCHASE_ACTION=offsite_conversion.fb_pixel_purchase  # confirmado: solo compras del píxel

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v23

# --- TikTok Ads ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_CONVERSION_METRIC=complete_payment
TIKTOK_REVENUE_METRIC=total_complete_payment_rate

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=
# Opción A (app creada en el Dev Dashboard, recomendada desde 2026):
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Opción B (app custom legacy creada antes del 1-ene-2026):
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10

# --- Google Analytics 4 (cuenta de servicio dedicada, solo lectura) ---
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
